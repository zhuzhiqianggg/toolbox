{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toolbox",
  "mainBinaryName": "toolbox",
  "version": "0.1.0",
  "identifier": "com.zhuzhiqiang.toolbox",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toolbox",
        "visible": false,
        "devtools": false,
        "width": 900,
        "height": 620,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "center": true,
        "focus": true,
        "minWidth": 640,
        "minHeight": 440
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true,
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Toolbox",
    "category": "Productivity",
    "shortDescription": "Toolbox — 一键呼出的桌面效率套件",
    "longDescription": "Toolbox：常驻托盘的跨平台桌面效率套件，提供统一命令面板、桌面整理、便签待办、剪贴板增强与效率工具箱。纯本地、默认不联网。",
    "copyright": "Copyright © Toolbox. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:toolbox.db"]
    },
    "updater": {
      "pubkey": "dW5zaWduZWQtcGxhY2Vob2xkZXItcmVwbGFjZS1iZWZvcmUtcmVsZWFzZQ==",
      "endpoints": [
        "https://releases.toolbox.example/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}

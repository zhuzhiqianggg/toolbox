{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Handy 主窗口默认能力（最小权限）。注：shell:allow-open 作用域由默认的 http(s)/mailto/tel 扩展为放行任意路径 —— 桌面网格挂件需打开本地原文件（文件引用型桌面整理的核心能力）；条目打开另有 Rust 侧 grid_open_path 兜底，此处放开供前端 ipc.shellOpen 既有调用使用。",
  "windows": ["main", "settings", "organizer", "note-*", "grid-overlay", "workstation-bar"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-center",
    "core:window:allow-start-dragging",
    "core:window:allow-is-visible",
    "core:window:allow-set-always-on-top",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "core:window:allow-outer-position",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-current-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-scale-factor",
    "core:app:allow-version",
    "global-shortcut:default",
    "store:default",
    "sql:default",
    "sql:allow-execute",
    "clipboard-manager:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-text",
    "dialog:default",
    "dialog:allow-confirm",
    "notification:default",
    "notification:allow-notify",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "os:default",
    "process:default",
    "updater:default",
    "log:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://**" },
        { "url": "http://**" },
        { "url": "mailto:**" },
        { "url": "tel:**" },
        { "url": "**" }
      ]
    },
    "autostart:default"
  ]
}
